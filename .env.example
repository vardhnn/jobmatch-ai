# ── Database ─────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
# For Postgres later: "postgresql://user:pass@localhost:5432/jobmatch"

# ── Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-generate-with-openssl-rand-hex-32"

# First-run account created by `npm run seed`
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="change-me"

# ── Mode ─────────────────────────────────────────────────
# "development" enables demo job sources + offline AI fallback
# "production" requires real provider credentials
APP_MODE="development"

# ── AI provider (OpenRouter) ───────────────────────────
# OpenRouter serves the language model for resume parsing, job analysis,
# search-query generation and match explanations. Key is server-side only.
# Get a free key at https://openrouter.ai/keys
AI_PROVIDER="openrouter"   # "openrouter" | "heuristic" (offline, zero-key)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"
# Tried in order when the primary model is rate-limited (429) or errors.
# Free models share a throttled upstream pool — keep this list non-empty.
OPENROUTER_FALLBACK_MODELS="stealth/space-bunny-alpha,qwen/qwen3.7-plus"
AI_TIMEOUT_MS="90000"
AI_MAX_RETRIES="2"

# ── Provider routing / BYOK ─────────────────────────────────
# Free models share a throttled upstream pool. To get a private quota, attach
# your own Google AI Studio key at https://openrouter.ai/settings/integrations,
# then name the provider here so requests prefer it over the shared pool.
OPENROUTER_PROVIDER_ORDER=""      # e.g. "Google AI Studio"
OPENROUTER_PROVIDER_FALLBACKS="1" # "0" forbids falling back to the shared pool
AI_JSON_MODE="1"                  # "0" disables strict response_format JSON

# ── Decision engine (JEV) ────────────────────────────────
# JEV (TypeSafeAI) is the decision/matching layer. It runs as a separate
# model via the same OpenRouter account — it NEVER handles language tasks.
# It is served from OpenRouter's Decisions API (/api/alpha/decisions),
# NOT chat/completions: it answers typed questions with probabilities.
DECISION_PROVIDER="jev"   # "jev" | "heuristic" (dev engine — NOT JEV)
JEV_MODEL="typesafe/jev-1.13"

# ── Job sources ──────────────────────────────────────────
# LinkedIn / Indeed / Naukri require official partner credentials.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Adzuna (free: https://developer.adzuna.com)
ADZUNA_APP_ID=""
ADZUNA_API_KEY=""

# ── Daily search schedule ────────────────────────────────
# Standard cron: minute hour day-of-month month day-of-week
SEARCH_CRON="0 7 * * *"
SEARCH_TIMEZONE="UTC"

# ── Limits ───────────────────────────────────────────────
MAX_RESUME_BYTES="10485760"  # 10 MB
